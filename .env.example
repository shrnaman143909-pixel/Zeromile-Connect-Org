# Zeromile Connect - Environment Configuration Template
# Copy this file to .env and configure with your project credentials.
# NEVER commit .env files containing real keys or secrets to Git.

# Gemini AI API Key (used for grievance understanding, classification, and transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase URL & Public Anon Key
# In Android, accessed via BuildConfig / secrets Gradle plugin
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
